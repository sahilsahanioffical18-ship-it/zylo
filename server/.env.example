PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://zylo:zylo@localhost:5432/zylo
TEST_DATABASE_URL=postgres://zylo:zylo@localhost:5432/zylo_test
# From the Clerk dashboard → API keys (app named "Zylo")
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local dev: `npm run livekit` (brew install livekit) prints these on startup.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Redis: live meeting state (seats, lobby, screen share), shared rate limits and the
# translation cache. Unset: rate limits and the cache fall back to per-server memory,
# but meetings need Redis, so every join is refused.
REDIS_URL=redis://localhost:6379
# Proxy hops in front of this server: 0 locally, 1 behind Railway or Fly.
TRUST_PROXY=0
